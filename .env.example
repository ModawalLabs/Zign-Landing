# Where "Start free" and "Sign in" lead: the Zign app (zign-v2). Origin only.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# This site's own public origin, for canonical URLs, Open Graph and the sitemap.
# Leave empty in development.
NEXT_PUBLIC_SITE_URL=

# Optional. When set, a "Write to us" link appears in the FAQ and the footer.
NEXT_PUBLIC_CONTACT_EMAIL=
